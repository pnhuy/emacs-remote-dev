;;; rdev-cache-test.el --- attribute cache bounds and invalidation (T043)  -*- lexical-binding: t; -*-
(require 'rdev-test-helpers)

(ert-deftest rdev-cache-evicts-oldest-first ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-max-entries 3) (rdev-cache-ttl 100)
          (conn (rdev--conn "test")))
      (clrhash (rdev-conn-cache conn))
      (dolist (n '("a.txt" "sub/b.txt" "unicode.txt" "empty"))
        (file-exists-p (concat remote n))
        (sleep-for 0.01))
      (should (= 3 (hash-table-count (rdev-conn-cache conn))))
      (should-not (gethash (directory-file-name (concat (file-local-name remote) "a.txt"))
                           (rdev-conn-cache conn)))
      (should (gethash (concat (file-local-name remote) "empty") (rdev-conn-cache conn)))
      (should (>= (plist-get (rdev-cache-stats "test") :evictions) 1)))))

(ert-deftest rdev-cache-refresh-makes-entry-newest ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-max-entries 2) (rdev-cache-ttl 0.05)
          (conn (rdev--conn "test")))
      (clrhash (rdev-conn-cache conn))
      (file-exists-p (concat remote "a.txt"))
      (sleep-for 0.01)
      (file-exists-p (concat remote "empty"))
      (sleep-for 0.08)                  ; both expire; re-stat a.txt => newest
      (file-exists-p (concat remote "a.txt"))
      (sleep-for 0.01)
      (file-exists-p (concat remote "unicode.txt")) ; evicts the oldest, which is `empty'
      (should (gethash (concat (file-local-name remote) "a.txt") (rdev-conn-cache conn)))
      (should-not (gethash (concat (file-local-name remote) "empty") (rdev-conn-cache conn))))))

(ert-deftest rdev-cache-hit-miss-counters ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-ttl 100) (conn (rdev--conn "test")))
      (clrhash (rdev-conn-cache conn))
      (setf (rdev-conn-stats conn) nil)
      (file-exists-p (concat remote "a.txt"))
      (file-exists-p (concat remote "a.txt"))
      (file-exists-p (concat remote "a.txt"))
      (let ((s (rdev-cache-stats "test")))
        (should (= 1 (plist-get s :misses)))
        (should (= 2 (plist-get s :hits)))))))

(ert-deftest rdev-cache-dropped-on-generation-change ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-ttl 100) (conn (rdev--conn "test"))
          (f (concat remote "a.txt")))
      (should (file-exists-p f))
      (delete-file (concat (file-local-name remote) "a.txt")) ; behind rdev's back
      (should (file-exists-p f))        ; stale but within TTL, same generation
      (setf (rdev-conn-gen conn) (1+ (or (rdev-conn-gen conn) 0)))
      (should-not (file-exists-p f)))))

(ert-deftest rdev-cache-mutators-invalidate-target-and-parent ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-ttl 100))
      (should (file-exists-p (concat remote "a.txt")))
      (delete-file (concat remote "a.txt"))
      (should-not (file-exists-p (concat remote "a.txt")))
      (write-region "x" nil (concat remote "new.txt") nil 'silent)
      (should (file-exists-p (concat remote "new.txt")))
      (rename-file (concat remote "new.txt") (concat remote "moved.txt"))
      (should-not (file-exists-p (concat remote "new.txt")))
      (should (file-exists-p (concat remote "moved.txt")))
      (make-directory (concat remote "d1"))
      (should (file-directory-p (concat remote "d1")))
      (set-file-modes (concat remote "moved.txt") #o600)
      (should (= #o600 (file-modes (concat remote "moved.txt")))))))

(ert-deftest rdev-cache-delete-directory-drops-descendants ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-ttl 100))
      (should (file-exists-p (concat remote "sub/b.txt")))
      (delete-directory (concat remote "sub") t)
      (should-not (file-exists-p (concat remote "sub/b.txt"))))))

(ert-deftest rdev-cache-process-file-clears-host-cache ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-ttl 100) (default-directory remote))
      (should (file-exists-p (concat remote "a.txt")))
      (process-file "rm" nil nil nil "a.txt")
      (should-not (file-exists-p (concat remote "a.txt"))))))

(ert-deftest rdev-clear-cache-prefix-arg-targets-one-host ()
  (rdev-test-with-twin-dir (native remote)
    (let ((conn (rdev--conn "test")) (rdev-cache-ttl 100))
      (file-exists-p (concat remote "a.txt"))
      (should (> (hash-table-count (rdev-conn-cache conn)) 0))
      (rdev-clear-cache "other-host")
      (should (> (hash-table-count (rdev-conn-cache conn)) 0))
      (rdev-clear-cache "test")
      (should (= 0 (hash-table-count (rdev-conn-cache conn)))))))

(ert-deftest rdev-statmany-prefetch-one-round-trip ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-ttl 100) (conn (rdev--conn "test")) (calls nil)
          (orig (symbol-function 'rdev--req)))
      (clrhash (rdev-conn-cache conn))
      (cl-letf (((symbol-function 'rdev--req)
                 (lambda (h m &rest r) (push m calls) (apply orig h m r))))
        (let ((got (file-name-completion
                    "" remote (lambda (f) (not (file-directory-p f))))))
          (should got))
        (should (= 1 (cl-count :fs/statMany calls)))
        ;; the predicate's per-candidate stats were all served from the prefetch
        (should (<= (cl-count :fs/stat calls) 2))))))

(ert-deftest rdev-statmany-missing-path-not-cached-as-error ()
  (rdev-test-with-twin-dir (native remote)
    (let ((rdev-cache-ttl 100))
      (rdev--prefetch-stats "test" (list (concat (file-local-name remote) "nope")
                                         (concat (file-local-name remote) "a.txt")))
      (should (file-exists-p (concat remote "a.txt")))
      (should-not (file-exists-p (concat remote "nope"))))))

(provide 'rdev-cache-test)
