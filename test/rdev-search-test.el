;;; rdev-search-test.el --- rdev-search client (T091)  -*- lexical-binding: t; -*-
(require 'rdev-test-helpers)
(require 'rdev-search)

(ert-deftest rdev-search-finds-matches-with-either-engine ()
  (rdev-test-with-twin-dir (native remote)
    (with-temp-file (expand-file-name "a.txt" (file-local-name remote)) (insert "alpha\nneedle one\n"))
    (make-directory (expand-file-name "d" (file-local-name remote)))
    (with-temp-file (expand-file-name "d/b.txt" (file-local-name remote)) (insert "Needle two\n"))
    (let ((res (rdev-search remote "needle")))
      (should (= 2 (plist-get res :count)))
      (should-not (plist-get res :truncated))
      (should (member (plist-get res :engine) '("rg" "python")))
      (should (equal '("a.txt" "d/b.txt")
                     (sort (mapcar (lambda (m) (plist-get m :path))
                                   (plist-get res :matches))
                           #'string<))))))

(ert-deftest rdev-search-streams-batches-and-truncates ()
  (rdev-test-with-twin-dir (native remote)
    (with-temp-file (expand-file-name "many.txt" (file-local-name remote))
      (dotimes (_ 300) (insert "hit\n")))
    (let* ((batches 0)
           (res (rdev-search remote "hit" :max-results 120
                             :on-match (lambda (_b) (cl-incf batches)))))
      (should (= 120 (plist-get res :count)))
      (should (plist-get res :truncated))
      (should (= 120 (length (plist-get res :matches))))
      (should (>= batches 1)))))

(ert-deftest rdev-search-invalid-regex-signals ()
  (rdev-test-with-twin-dir (native remote)
    (should-error (rdev-search remote "(oops" :regex t))))

(ert-deftest rdev-search-rejects-local-dir ()
  (should-error (rdev-search "/tmp/" "x") :type 'user-error))

;;; Optional Consult adapter (T125, FR-024)

(ert-deftest rdev-search-consult-candidates-carry-remote-position ()
  (rdev-test-with-twin-dir (native remote)
    (with-temp-file (expand-file-name "a.txt" (file-local-name remote)) (insert "alpha\nneedle one\n"))
    (let ((cands (rdev-search--consult-candidates remote "needle")))
      (should (= 1 (length cands)))
      (should (equal "a.txt:2:needle one" (substring-no-properties (car cands))))
      (pcase-let ((`(,file ,line ,col) (get-text-property 0 'rdev-match (car cands))))
        (should (equal (expand-file-name "a.txt" remote) file))
        (should (string-prefix-p "/rdev:" file))
        (should (= 2 line))
        (should (= 1 col))))
    (should-not (rdev-search--consult-candidates remote ""))
    (should-not (rdev-search--consult-candidates remote nil))))

(ert-deftest rdev-search-consult-visit-opens-file-at-match ()
  (rdev-test-with-twin-dir (native remote)
    (with-temp-file (expand-file-name "a.txt" (file-local-name remote)) (insert "alpha\nbeta needle\n"))
    (let ((cand (car (rdev-search--consult-candidates remote "needle"))))
      (save-window-excursion
        (rdev-search--visit cand)
        (unwind-protect
            (progn (should (equal (expand-file-name "a.txt" remote) buffer-file-name))
                   (should (= 2 (line-number-at-pos)))
                   (should (= 5 (current-column))))
          (kill-buffer (current-buffer)))))))

(ert-deftest rdev-search-consult-grep-without-consult-is-a-clear-error ()
  "Without the optional package the command explains itself and loads nothing."
  (cl-letf (((symbol-function 'require)
             (let ((orig (symbol-function 'require)))
               (lambda (feature &optional file noerror)
                 (if (eq feature 'consult) nil (funcall orig feature file noerror))))))
    (let ((err (should-error (rdev-consult-grep "/rdev:test:/tmp/") :type 'user-error)))
      (should (string-match-p "consult" (error-message-string err)))
      (should (string-match-p "rdev-grep" (error-message-string err))))))

(ert-deftest rdev-search-consult-grep-with-consult-visits-selection ()
  "With Consult present the command feeds remote candidates to `consult--read'."
  (let ((dirs (file-expand-wildcards (expand-file-name "elpa/consult-[0-9]*" user-emacs-directory))))
    (unless dirs (ert-skip "consult is not installed"))
    (let ((load-path (append dirs load-path)))
      (require 'consult)
      (rdev-test-with-twin-dir (native remote)
        (with-temp-file (expand-file-name "a.txt" (file-local-name remote)) (insert "alpha\nbeta needle\n"))
        (cl-letf (((symbol-function 'consult--dynamic-collection)
                   (lambda (fun &rest _) fun))
                  ((symbol-function 'consult--read)
                   (lambda (collection &rest args)
                     (let ((cands (funcall collection "needle")))
                       (should (= 1 (length cands)))
                       (should (equal "Remote grep: " (plist-get args :prompt)))
                       (funcall (plist-get args :lookup) (car cands) cands)))))
          (save-window-excursion
            (rdev-consult-grep remote)
            (unwind-protect
                (progn (should (equal (expand-file-name "a.txt" remote) buffer-file-name))
                       (should (= 2 (line-number-at-pos))))
              (kill-buffer (current-buffer)))))))))

(ert-deftest rdev-search-consult-grep-rejects-local-directory ()
  (cl-letf (((symbol-function 'require) (lambda (&rest _) t)))
    (should-error (rdev-consult-grep "/tmp/") :type 'user-error)))
