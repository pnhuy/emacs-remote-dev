;;; rdev-handlers-dir-test.el --- directory operations (T018)  -*- lexical-binding: t; -*-
(require 'rdev-test-helpers)

(ert-deftest rdev-dir-directory-files-matches-native ()
  (rdev-test-with-twin-dir (native remote)
    (should (equal (directory-files native) (directory-files remote)))
    (should (equal (directory-files native nil "\\.txt\\'") (directory-files remote nil "\\.txt\\'")))
    ;; COUNT picks the first N in readdir order (filesystem-dependent), so compare length only.
    (should (= 3 (length (directory-files native nil nil nil 3))
               (length (directory-files remote nil nil nil 3))))
    (should (equal (mapcar #'file-name-nondirectory (directory-files remote t "\\.txt\\'"))
                   (directory-files native nil "\\.txt\\'")))
    (should (string-prefix-p "/rdev:test:" (car (directory-files remote t "a"))))))

(ert-deftest rdev-dir-files-and-attributes ()
  (rdev-test-with-twin-dir (native remote)
    (let ((n (directory-files-and-attributes native nil "\\`[a-z]"))
          (r (directory-files-and-attributes remote nil "\\`[a-z]")))
      (should (equal (mapcar #'car n) (mapcar #'car r)))
      (should (equal (mapcar (lambda (e) (file-attribute-type (cdr e))) n)
                     (mapcar (lambda (e) (file-attribute-type (cdr e))) r))))))

(ert-deftest rdev-dir-completion ()
  (rdev-test-with-twin-dir (native remote)
    (should (equal (sort (file-name-all-completions "s" native) #'string<)
                   (sort (file-name-all-completions "s" remote) #'string<)))
    (should (equal (file-name-completion "a." native) (file-name-completion "a." remote)))
    (should (equal (file-name-completion "zzz" remote) nil))
    (should (member "sub/" (file-name-all-completions "s" remote)))))

(ert-deftest rdev-dir-make-and-delete ()
  (rdev-test-with-twin-dir (native remote)
    (make-directory (concat remote "n1"))
    (should (file-directory-p (concat remote "n1")))
    (should-error (make-directory (concat remote "n1")) :type 'file-already-exists)
    (make-directory (concat remote "p/q/r") t)
    (should (file-directory-p (concat remote "p/q/r")))
    (should-error (delete-directory (concat remote "p")) :type 'file-error)
    (delete-directory (concat remote "p") t)
    (should-not (file-exists-p (concat remote "p")))
    (delete-directory (concat remote "n1"))
    (should-not (file-exists-p (concat remote "n1")))))

(ert-deftest rdev-dir-insert-directory-and-dired ()
  (rdev-test-with-twin-dir (native remote)
    (with-temp-buffer
      (insert-directory remote "-al" nil t)
      (should (string-match-p "a\\.txt" (buffer-string)))
      (should (string-match-p "sub" (buffer-string))))
    (let ((buf (dired-noselect remote)))
      (unwind-protect
          (with-current-buffer buf
            (goto-char (point-min))
            (should (re-search-forward "a\\.txt" nil t)))
        (kill-buffer buf)))))

(provide 'rdev-handlers-dir-test)
;;; rdev-handlers-dir-test.el ends here

(ert-deftest rdev-dir-large-listing-uses-compressed-form ()
  "A big listing arrives zlib-compressed and decodes to the same entries."
  (skip-unless (and (fboundp 'zlib-available-p) (zlib-available-p)))
  (rdev-test-with-twin-dir (native remote)
    (dotimes (i 80)
      (dolist (d (list native (file-local-name remote)))
        (write-region "" nil (expand-file-name (format "bulk%02d" i) d) nil 'silent)))
    (let* ((orig (symbol-function 'rdev--req)) (shapes nil))
      (cl-letf (((symbol-function 'rdev--req)
                 (lambda (h m &rest r)
                   (let ((v (apply orig h m r)))
                     (when (eq m :fs/readdir) (push (if (vectorp v) 'plain 'z) shapes))
                     v))))
        (rdev-clear-cache)
        (let ((n (directory-files-and-attributes native nil "\\`bulk"))
              (r (directory-files-and-attributes remote nil "\\`bulk")))
          (should (equal (mapcar #'car n) (mapcar #'car r)))
          (should (equal (mapcar (lambda (e) (file-attribute-size (cdr e))) n)
                         (mapcar (lambda (e) (file-attribute-size (cdr e))) r)))))
      (should (equal shapes '(z))))))
